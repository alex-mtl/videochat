doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Video Chat Public Room: "#{roomID}"
    script(src="/static/js/mafia/util.js", defer)
    script(src="/static/js/vc-utils.js", defer)
    script(src="/static/js/mafia/game.js", defer)
    script(src="/static/js/mafia/host.js", defer)
    script(src="https://cdnjs.cloudflare.com/ajax/libs/howler/2.2.3/howler.min.js")

    link(href="/static/css/m-game.css", rel="stylesheet")
    //link(href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous", rel="stylesheet")
    //script(src="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/js/bootstrap.bundle.min.js", integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL", crossorigin="anonymous", defer)
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css", rel="stylesheet", integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN", crossorigin="anonymous")
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js", integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL", crossorigin="anonymous", defer)
    link(href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200", rel="stylesheet")
    link(href="https://fonts.googleapis.com/icon?family=Material+Icons", rel="stylesheet")

  body.g-mafia.test2024
    script let chatSessionID = "#{sessionID}"; let roomId = "#{roomID}";var websocketUrl = "#{wssURL}";
    .game.videos
      #remoteVideos.videos.video-grid
        // each player, slot in room.slot
        each slot in [9, 10, 1, 2, 8]
          - const player = room.slot[slot]
          - var vbID = "video-"+slot+"-empty"
          include elems/videobox.pug
        //div.videobox#game-host
        - const player = room.gameHost
        - var vbID = 'game-host'
        - var vID = 'hostVideo'
        - var muted = 'muted'
        - var slot = 'game-host'
        include elems/videobox.pug
        div.game-panel
          video.g-mask.play.muted#localVideo(autoplay, muted, playsinline)
          include elems/game-actions.pug
          include elems/host-panel.pug
          include elems/player-panel.pug
          include elems/equalizer.pug
        each slot in [3, 7, 6, 5, 4]
          - const player = room.slot[slot]
          - var vbID = "video-"+slot+"-empty"
          include elems/videobox.pug
    include elems/card-deck.pug
    include elems/number-pad.pug
    #chat
      div
        input#chat-input(type="text")
        button#sendMessage(onclick="sendMessage(this)") Send
      table#chat-messages
        tr
          th.chat-time time
          th.chat-from from
          th.chat-to to
          th.chat-message message
    include elems/media-source.pug