doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title User Profile
    script(src="/static/js/mafia/user.js", defer)
    link(href="/static/css/m-home.css", rel="stylesheet")
    link(href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200", rel="stylesheet")
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css", rel="stylesheet", integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN", crossorigin="anonymous")
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js", integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL", crossorigin="anonymous", defer)
  body
    script let chatSessionID = "#{sessionID}"; var websocketUrl = "#{wssURL}";
    - var title = "User Profile"
    include elems/layout-header
    section
      .container
        .row
          .col-lg-4
            .card.mb-4
              .card-body.text-center
                img(src=avatar, alt="avatar", class="rounded-circle img-fluid", style="width: 150px;")
                h5.my-3 #{username}
                p.text-muted.mb-1 #{user.level || ''}
                p.text-muted.mb-4 #{country || ''}
                <!-- Button to Open the Modal -->
                button.btn.btn-primary(type="button" data-bs-toggle="modal" data-bs-target="#uploadModal") Upload Image
                button.btn.btn-primary(type="button" data-bs-toggle="modal" data-bs-target="#editUserModal") Edit Info

                include elems/upload-avatar
                include elems/edit-user-info
                include elems/form-erorrs-modal

          .col-lg-8
            .card.mb-4
              .card-body
                each propValue, propName in userProps
                  include elems/card-row
            .row
              - var card = user.stats || {}
              include elems/user-stats
              - var card = user.badges || {}
              include elems/user-badges
    .footer © MAO Game Platform