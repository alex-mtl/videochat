.number-pad#num-pad
    .row-one
        span.pad.one.material-symbols-outlined(onclick="numPadClick(this)", data-pad-type="num", data-pad-value="1")
        span.pad.two.material-symbols-outlined(onclick="numPadClick(this)", data-pad-type="num", data-pad-value="2")
        span.pad.three.material-symbols-outlined(onclick="numPadClick(this)", data-pad-type="num", data-pad-value="3")
        span.pad.four.material-symbols-outlined(onclick="numPadClick(this)", data-pad-type="num", data-pad-value="4")
        span.pad.five.material-symbols-outlined(onclick="numPadClick(this)", data-pad-type="num", data-pad-value="5")
    .row-two
        span.pad.six.material-symbols-outlined(onclick="numPadClick(this)", data-pad-type="num", data-pad-value="6")
        span.pad.seven.material-symbols-outlined(onclick="numPadClick(this)", data-pad-type="num", data-pad-value="7")
        span.pad.eight.material-symbols-outlined(onclick="numPadClick(this)", data-pad-type="num", data-pad-value="8")
        span.pad.nine.material-symbols-outlined(onclick="numPadClick(this)", data-pad-type="num", data-pad-value="9")
        span.pad.ten.material-symbols-outlined(onclick="numPadClick(this)", data-pad-type="num", data-pad-value="10")
    .row-three
        span.pad.grey.material-icons(onclick="numPadClick(this)", data-pad-type="color", data-pad-value="unknown")
        span.pad.red.material-icons(onclick="numPadClick(this)", data-pad-type="color", data-pad-value="red")
        span.pad.black.material-icons(onclick="numPadClick(this)", data-pad-type="color", data-pad-value="black")
        span.pad.send.material-symbols-outlined(onclick="numPadClick(this)", data-pad-type="action", data-pad-value="send")
        span.pad.cancel.material-symbols-outlined(onclick="numPadClick(this)", data-pad-type="action", data-pad-value="cancel")
        
