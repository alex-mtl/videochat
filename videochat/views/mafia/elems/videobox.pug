.videobox.no-video(data-slot=slot, data-uid=player.uid, id=vbID, class="vbox-"+slot, data-name=player.name)
    video.g-mask.play.material-symbols-outlined(autoplay, id=vID, muted)
    button.g-mask.material-symbols-outlined(style="margin-left: 40px;" onclick="toggleAudio(this)") volume_off
    button.g-mask.material-symbols-outlined(onclick="toggleVideo(this)") videocam_off
    .slot.g-mask= slot
    span.game-user.g-mask= player.name
    input.game-user.g-mask(type="text", minlength="15", value=player.name, onblur="setPlayerName(this)")
    span.player-name-confirm
    input.g-mask#volumeSlider(type='range' min='0' max='1' step='0.05' value='1' onchange="adjustVolume(this.parentElement.querySelector('video'), this.value )")
    span.g-mask.slot-status(class="material-symbols-outlined", data-status=player.status, onclick="changeUserStatus(this)")
    span.g-mask.slot-mic(class="material-symbols-outlined", data-mic=player.mic)
    span.slot-role.material-symbols-outlined(data-role=player.role)
    span.video-lock.material-symbols-outlined
    span.video-target.material-symbols-outlined(onclick="shoot(this)")
    span.slot-shout.material-symbols-outlined(onclick="shoutOut(this)")
    span.slot-warn-remove.material-symbols-outlined(onclick="warnRemove(this)")
    span.slot-warn.material-symbols-outlined(class=`${player.warn ? 'warn-' + player.warn : ''}`)
    span.slot-warn-add.material-symbols-outlined(onclick="warnAdd(this)")
    span.slot-nominate.material-symbols-outlined(onclick="nominate(this)")
    span.slot-candidate.material-symbols-outlined(onclick="vote(this)")
    span.slot-vote.material-symbols-outlined

    .select-slot
        .e-container
            .middle.full-size(style="bottom:0;")
                button.btn.btn-primary.btn-lg(onclick='selectSlot('+slot+')' type="button" data-btn="select-slot")= slot
                //span= slot