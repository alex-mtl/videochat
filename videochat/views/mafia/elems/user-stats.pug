.col-md-6
  .card.mb-4.mb-md-0
    .card-body
      h3.text-primary.mb-4 #{card.title || '{CARD_TITLE}'}
      each row in card.data
        p.mb-1.mt-4(style="font-size: .77rem;") #{row.type}
        .progress.rounded(style="height: 5px;")
          .progress-bar(role="progressbar", style=`width: `+row.value[2]+`%`, aria-valuenow=row.value[0], aria-valuemin="0", aria-valuemax=row.value[1])
