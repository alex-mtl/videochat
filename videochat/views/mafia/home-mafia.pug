doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Mafia - MAO Game Platform
    script(src=`/static/js/mafia/util.js?ver=${ver}`, defer)
    script(src=`/static/js/mafia/home.js?ver=${ver}`, defer)
    link(href=`/static/css/m-home.css?ver=${ver}`, rel="stylesheet")
    link(href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200", rel="stylesheet")
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css", rel="stylesheet", integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN", crossorigin="anonymous")
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js", integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL", crossorigin="anonymous", defer)
  body
    script let chatSessionID = "#{sessionID}"; var websocketUrl = "#{wssURL}";
    include elems/layout-header
    .container.homepage
      //- Add this tabs navigation
      ul.nav.nav-tabs.mb-3
        li.nav-item
          a.nav-link.active(href="#active-tab" data-bs-toggle="tab") Active
        li.nav-item
          a.nav-link(href="#history-tab" data-bs-toggle="tab") History

      //- Wrap your current content in a tab-content div
      .tab-content
        #active-tab.tab-pane.fade.show.active
          form.mb-3#create-room
            .row.g-3.align-items-center
              .col
                input.form-control#userName(type="text", placeholder="Nickname", value=nickname, disabled=nickname ? true : false)
              .col
                input.form-control#roomName(type="text", placeholder="Roomname")
              .col
                button.btn.btn-primary.btn-create#createRoom(type="button") Create
          .table-container
            table.table.table-striped
              thead
                tr
                  th.th-host(scope="col") Host
                  th.th-room(scope="col") Room
                  //th.th-phase(scope="col") Phase
                  th.th-users(scope="col") Users
                  //th.th-alive(scope="col") Alive
                  th.th-actions(scope="col") Actions
              tbody
                each r in roomList
                  tr(id=`roomID-${r.name}`)

                    td
                      .player-slots-container
                        .player-slot.first
                          if r.host.mduid && r.host.mduid !== 'null'
                            a.player-slot-link(href="/u/" + r.host.mduid)
                              .avatar-container
                                img.avatar(src=r.host.avatar || "/static/img/100x100.png", alt=`${r.host.name}`)
                                .role-badge.material-symbols-outlined.H
                          else
                            .avatar-container
                              img.avatar(src=r.host.avatar || "/static/img/100x100.png", alt=`${r.host.name}`)
                              .role-badge.material-symbols-outlined.H
                    //td= r.game.phase
                    td= r.name
                    td.player-slots-cell
                      .player-slots-container
                        - for (let i = 1; i < 11; i++)
                          .player-slot(class=i === 1 ? 'first' : '')
                            if r.slot[i].mduid && r.slot[i].mduid !== 'null'
                              a.player-slot-link(href="/u/" + r.slot[i].mduid)
                                .avatar-container
                                  img.avatar(src=r.slot[i].avatar || "/static/img/avatar/d450356dc7cb3609.png", alt=`${r.slot[i].name}` tooltip=`${r.slot[i].name}`)
                                  .role-badge.material-symbols-outlined(class=r.slot[i].status)
                            else
                              .avatar-container
                                if r.slot[i].uid !== "empty"
                                  img.avatar(src=r.slot[i].avatar || "/static/img/avatar/d450356dc7cb3609.png", alt=`${r.slot[i].name}` tooltip=`${r.slot[i].name}`)
                                  .role-badge.material-symbols-outlined(class=r.slot[i].status)
                                else
                                  img.avatar(src="/static/img/avatar/d450356dc7cb3609.png", alt="Empty slot")



                    //td= r.aliveCount
                    if r.game.settings.password
                      td
                        button(onclick="joinGameWithPassword(this)", type="button", class="btn btn-primary")
                          span.pwd.material-symbols-outlined
                          | &nbsp Join Room
                    else
                      td
                        button(onclick="joinGame(this)", type="button", class="btn btn-primary") Join Room

        #history-tab.tab-pane.fade
          .table-container
            table.table.table-striped
              thead
                tr
                  th.th-host(scope="col") Host
                  th.th-room(scope="col") Room
                  th.th-club(scope="col") Club
                  th.player-slots-cell Players
                  th.th-result(scope="col") Result
                  //th.th-alive(scope="col") Details
              tbody
                each r in historyList || []
                  tr(id=`history-room-${r.name}`)
                    td
                      .player-slots-container
                         .player-slot.first
                            if r.host.mduid && r.host.mduid !== 'null'
                              a.player-slot-link(href="/u/" + r.host.mduid)
                                .avatar-container
                                  img.avatar(src=r.host.avatar || "/static/img/100x100.png", alt=`${r.host.name}`)
                                  .role-badge.material-symbols-outlined.H
                            else
                              .avatar-container
                                img.avatar(src=r.host.avatar || "/static/img/100x100.png", alt=`${r.host.name}`)
                                .role-badge.material-symbols-outlined.H
                    td= r.name
                    td
                      .player-slots-container
                        .player-slot.first
                          //if r.host?.club?.mduid && r.host?.club?.mduid !== 'null'
                          //  a.player-slot-link(href="/c/" + r.host.club.mduid)
                          //    .avatar-container
                          //      img.avatar(src=r.host?.club?.avatar || "/static/img/mafia-club.jpg", alt=`${r.host?.club?.name}`)
                          //else
                          .avatar-container
                            img.avatar(src="/static/img/mafia-club.jpg", alt=`Maofia Club`)
                    td.player-slots-cell
                      .player-slots-container
                        - for (let i = 0; i < 10; i++)

                          if r.players && r.players[i]
                            //.player-slot(style=`margin-left: -${i*2}vw;`)
                            .player-slot(class=i === 0 ? 'first' : '')
                              if r.players[i].mduid && r.players[i].mduid !== 'null'
                                a.player-slot-link(href="/u/" + r.players[i].mduid)
                                  .avatar-container
                                    img.avatar(src=r.players[i].avatar || "/static/img/default-avatar.png", alt="Player avatar")
                                    .role-badge.material-symbols-outlined(class=r.players[i].role)
                              else
                                .avatar-container
                                  img.avatar(src=r.players[i].avatar || "/static/img/default-avatar.png", alt="Player avatar")
                                  .role-badge.material-symbols-outlined(class=r.players[i].role)
                          else
                            .player-slot.empty(class=i === 0 ? 'first' : '')
                            //.player-slot.empty(style=`margin-left: -${i*2}vw;`)
                              img.avatar(src="/static/img/empty-slot.png", alt="Empty slot")
                              .role -

                    td.material-symbols-outlined.game-result(data-result=r.result)
                    //td
                    //  button.btn.btn-secondary View Details

      include elems/game-password.pug

    .footer © MAO Game Platform